{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker único: sirve la PWA (assets estáticos) y la API /api/* sobre D1, bajo el mismo dominio.
  "name": "rio-seco-conecta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa por el Worker; el resto (incluido el fallback de rutas React) lo sirven los assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rio-seco-conecta",
      "database_id": "6cd68129-5f4c-4bd5-9fef-58c8a753a265", // identificador (no es un secreto)
      "migrations_dir": "migrations"
    }
  ],
  // Cron cada 5 minutos: continúa lotes grandes de notificaciones, reintenta envíos fallidos y limpia datos viejos.
  // NO sincroniza Facebook/Instagram (`scheduledSync` sigue desactivado hasta el Sprint 06). Sin avisos pendientes
  // solo consulta una fila de D1 (≈288 consultas/día).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Contacto VAPID (RFC 8292): URL pública, no secreta. Los servicios push la usan para contactar al operador.
  "vars": { "VAPID_SUBJECT": "https://rio-seco-conecta.rea-04.workers.dev" },
  "observability": { "enabled": true }
  // Secretos (NO van acá): wrangler secret put META_PAGE_ACCESS_TOKEN | META_INSTAGRAM_ACCESS_TOKEN | VAPID_PUBLIC_KEY | VAPID_PRIVATE_KEY_JWK (ver docs/NOTIFICACIONES.md)
}
