{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker único: sirve la PWA (assets estáticos) y la API /api/* sobre D1, bajo el mismo dominio.
  "name": "rio-seco-conecta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa por el Worker; el resto (incluido el fallback de rutas React) lo sirven los assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rio-seco-conecta",
      "database_id": "6cd68129-5f4c-4bd5-9fef-58c8a753a265", // identificador (no es un secreto)
      "migrations_dir": "migrations"
    }
  ],
  // Sin "triggers.crons": la sincronización automática con Facebook/Instagram NO se activa todavía
  // (faltan credenciales de Meta). Se agregará cuando haya una fuente configurada y una justificación operativa.
  "observability": { "enabled": true }
  // Secretos (NO van acá): wrangler secret put META_PAGE_ACCESS_TOKEN | META_INSTAGRAM_ACCESS_TOKEN | VAPID_* (sprints posteriores)
}
