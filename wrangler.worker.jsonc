{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rio-seco-conecta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // La API pasa primero por el Worker; el resto lo sirven los assets estáticos.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rio-seco-conecta",
      // REEMPLAZAR con el id que devuelve `npx wrangler d1 create rio-seco-conecta` (no es un secreto).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Revisión de fuentes y envío de notificaciones cada minuto (el plan gratuito admite triggers cron).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "META_GRAPH_VERSION": "v23.0",
    "VAPID_SUBJECT": "mailto:CONFIGURAR@example.com"
  }
  // Secretos (NO van acá): wrangler secret put VAPID_PUBLIC_KEY | VAPID_PRIVATE_KEY_JWK | META_PAGE_ACCESS_TOKEN | META_INSTAGRAM_ACCESS_TOKEN
}
